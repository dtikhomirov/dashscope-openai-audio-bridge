# Every variable below is REQUIRED - the bridge has no built-in defaults and
# exits at startup with a log message listing anything missing or invalid.
# Copy to .env and fill in your values. .env is gitignored - never commit it.

# Alibaba Cloud Model Studio (DashScope) API key - any region/deployment
export ALI_API_KEY="your_aliyun_dashscope_api_key"

# DashScope endpoints - set the host for your account, paths are the same:
#   Mainland China:  https://dashscope.aliyuncs.com
#   International:   https://dashscope-intl.aliyuncs.com
#   Token Plan (SG): https://token-plan.ap-southeast-1.maas.aliyuncs.com
export ALI_TTS_URL="https://token-plan.ap-southeast-1.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer"
export ALI_STT_URL="https://token-plan.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"

# Bridge server
export BRIDGE_HOST=0.0.0.0
export BRIDGE_PORT=4005

# Default audio format (model and voice are NOT configured here - the OpenAI
# spec requires both in every TTS request; see README usage examples)
# Voice names: qwen-audio-3.0-tts-plus-{suffix} for base voices, e.g.
# loongjameszhao; alternatives: longanlufeng (M), longanlingxin (F), loongivyhu (F news)
# Voice list: https://www.alibabacloud.com/help/en/model-studio/qwen-audio-tts-voice-list
export TTS_FORMAT=wav
export TTS_SAMPLE_RATE=24000

# Timeouts and limits
export REQUEST_TIMEOUT=120
export MAX_BASE64_BYTES=10485760

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
export LOG_LEVEL=INFO
